# Application
APP_NAME=tecnofit
APP_ENV=dev

# Database
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=hyperf
DB_PASSWORD=hyperf
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# Redis
REDIS_HOST=redis
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@tecnofit.com
MAIL_FROM_NAME=Tecnofit

ASYNC_QUEUE_DRIVER=redis

# Logging
SYSLOG_HOST=promtail
SYSLOG_PORT=1514

# Observability
METRIC_DRIVER=prometheus
TELEMETRY_USE_STANDALONE_PROCESS=true
TELEMETRY_ENABLE_DEFAULT_TELEMETRY=true
DEFAULT_METRIC_INTERVAL=5

PROMETHEUS_REDIS_CONFIG=default
PROMETHEUS_REDIS_PREFIX=prometheus:
PROMETHEUS_REDIS_GATHER_KEY_SUFFIX=:metric_keys

PROMETHEUS_SCRAPE_HOST=0.0.0.0
PROMETHEUS_SCRAPE_PORT=9502
PROMETHEUS_SCRAPE_PATH=/metrics

PROMETHEUS_PUSH_HOST=0.0.0.0
PROMETHEUS_PUSH_PORT=9091
PROMETHEUS_PUSH_INTERVAL=5
